@model IEnumerable<ARENDATOR.Web.Models.Booking>
@{
    ViewData["Title"] = "My Booking History";
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Reservations</span>
                <h2>My booking history</h2>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Property</th>
                        <th>Dates</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.Property.Title</td>
                            <td>@booking.StartDate.ToShortDateString() - @booking.EndDate.ToShortDateString()</td>
                            <td>$@booking.TotalPrice</td>
                            <td><span class="badge bg-info text-dark">@booking.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
